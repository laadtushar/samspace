{
  "mcpServers": {
    "logoloom": {
      "command": "npx",
      "args": [
        "-y",
        "@mcpware/logoloom"
      ]
    },
    "dataforseo": {
      "command": "npx",
      "args": [
        "-y",
        "dataforseo-mcp-server@3.1.1"
      ],
      "env": {
        "DATAFORSEO_LOGIN": "${DATAFORSEO_LOGIN}",
        "DATAFORSEO_PASSWORD": "${DATAFORSEO_PASSWORD}"
      }
    },
    "search-console": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-gsc@0.3.0"
      ],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS}"
      }
    }
  }
}
