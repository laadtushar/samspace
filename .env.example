# ─── Admin dashboard ────────────────────────────────
# Password for /admin. Use a long, random value — it is the only thing
# standing between the internet and stored client records.
ADMIN_PASSWORD=

# Signs admin session cookies. Strongly recommended: set this to its own random
# value. If left unset the password itself is used as the signing key, which
# makes a stolen cookie an offline oracle for cracking the password.
# Changing this value logs every admin session out.
ADMIN_SESSION_SECRET=

# Encrypts intake submissions and blog posts before they are stored. The Blob
# store is public at the store level (fixed at creation), so confidentiality
# comes from encrypting the payload rather than from access control.
# WARNING: changing this makes everything already stored unreadable.
# Falls back to ADMIN_SESSION_SECRET if unset.
SUBMISSIONS_ENCRYPTION_KEY=

# ─── Storage ────────────────────────────────────────
# Vercel Blob. Set automatically when a Blob store is linked to the project on
# Vercel; needed explicitly for local development.
BLOB_READ_WRITE_TOKEN=

# ─── Email (Resend) ─────────────────────────────────
# Sends confirmation emails to people who submit a form.
RESEND_API=
# Sends notification emails to the therapist. Falls back to RESEND_API if unset.
RESEND_ADMIN_API=
# Optional overrides.
RESEND_FROM="Samvriti.Space <hello@samvritispace.com>"
THERAPIST_EMAIL=

# ─── Site ───────────────────────────────────────────
# Overrides the canonical origin used for metadata, sitemap and robots.
# Leave unset in production; Vercel preview deploys derive their own.
NEXT_PUBLIC_SITE_URL=
