# ─── Admin dashboard ────────────────────────────────
# Bootstrap password for /admin, used only until the first real account exists.
# The moment one administrator has a password and is enabled, this stops being
# accepted — otherwise every protection on those accounts could be walked around
# by whoever still had the shared secret. Use a long, random value.
ADMIN_PASSWORD=

# Signs admin session cookies. Strongly recommended: set this to its own random
# value. If left unset the password itself is used as the signing key, which
# makes a stolen cookie an offline oracle for cracking the password.
# Changing this value logs every admin session out.
ADMIN_SESSION_SECRET=

# Encrypts intake submissions and blog posts before they are stored. The Blob
# store is public at the store level (fixed at creation), so confidentiality
# comes from encrypting the payload rather than from access control.
# WARNING: changing this makes everything already stored unreadable.
# Falls back to ADMIN_SESSION_SECRET if unset.
SUBMISSIONS_ENCRYPTION_KEY=

# ─── Database (Neon Postgres) ───────────────────────
# The practice's own records: clients, sessions, reminders and administrator
# accounts. Migrations in db/migrations/ run at deploy time from the build
# script, so a deployment without this fails at build rather than at runtime.
# Set automatically when a Neon integration is linked on Vercel.
DATABASE_URL=
# Optional. A direct, non-pooled connection, used in preference for migrations.
DATABASE_URL_UNPOOLED=
# Only for the database-backed tests. CI fails rather than skipping them when
# this is unset, so a green run always means they actually ran.
TEST_DATABASE_URL=
# Also accepted in place of DATABASE_URL, for hosts that set that name instead.
POSTGRES_URL=

# ─── Email (Resend) ─────────────────────────────────
# Sends confirmation emails to people who submit a form.
RESEND_API=
# Sends notification emails to the therapist. Falls back to RESEND_API if unset.
RESEND_ADMIN_API=
# Optional overrides.
RESEND_FROM="Samvriti.Space <hello@samvritispace.com>"
THERAPIST_EMAIL=

# ─── Site ───────────────────────────────────────────
# Overrides the canonical origin used for metadata, sitemap and robots.
# Leave unset in production; Vercel preview deploys derive their own.
NEXT_PUBLIC_SITE_URL=

# ─── Bot protection (Vercel BotID) ──────────────────
# off (default) | observe | enforce
#
# BotID classifies from a signal its client-side script collects, so the script
# and the enforcement are one setting: there is no useful verdict without the
# script, and no safe enforcement without a verdict. Sit in "observe" until the
# logs are boring, then set "enforce".
#
# Do not skip "observe". In "enforce" a challenge that cannot load — blocked
# script, a bad moment on the network — means the request never leaves the
# browser and the person sees a generic failure with nothing in the server logs.
# On this site that person is someone trying to reach a therapist.
BOTID_MODE=

# Signs the scheduled reminder run. Vercel sets this for you when you add a
# cron; without it the endpoint refuses every request, because an endpoint that
# sends email on demand is a way to have email sent in your name.
CRON_SECRET=

# Emails every error-level log event (an intake that could not be stored, a
# failed reminder run, the database unreachable) to this address. Unset means
# no alerts. Sent with RESEND_ADMIN_API, falling back to RESEND_API.
ALERT_EMAIL=
# At most one alert per event name per this many minutes, per instance. Default 30.
ALERT_THROTTLE_MINUTES=
